{
  "name": "wolf-of-stall-street",
  "private": true,
  "version": "0.1.0",
  "description": "A turn-based medieval investing game. Climb from Serf to Count by trading guild shares, buying rumors and insuring your bets.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
